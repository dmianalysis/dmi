{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmianalysis.org/schemas/dmi_output.schema.json",
  "title": "DMI Release Output (JSON)",
  "description": "Schema for a single raw DMI release file (dmi_release_YYYY-MM[_slack_plus].json). Aligned with the output actually produced by scripts/compute_dmi.py:compute_dmi_for_period. Historical releases (pre-2026-03) may omit the specification/description fields and the spec-related parameters, so those are optional.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_period",
    "parameters",
    "dmi_by_group",
    "summary_metrics",
    "inflation_contributions",
    "metadata"
  ],
  "properties": {
    "reference_period": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "specification": {
      "description": "Specification identifier. Absent or null on pre-multi-spec historical releases.",
      "type": ["string", "null"],
      "enum": ["baseline", "slack_plus", null]
    },
    "description": {
      "description": "Human-readable specification description. Absent on pre-multi-spec historical releases.",
      "type": "string"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alpha", "scale_factor", "weights_year"],
      "properties": {
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scale_factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "weights_year": {
          "type": "integer"
        },
        "spec_id": {
          "type": "string",
          "enum": ["baseline", "slack_plus"]
        },
        "slack_measure": {
          "type": "string",
          "enum": ["u3", "u6"]
        },
        "inflation_measure": {
          "type": "string",
          "enum": ["HEADLINE_CPI"]
        }
      }
    },
    "dmi_by_group": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "dmi", "inflation", "slack"],
        "properties": {
          "group_id": {
            "type": "string",
            "pattern": "^Q[1-5]$"
          },
          "dmi": {
            "type": "number"
          },
          "inflation": {
            "type": "number"
          },
          "slack": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "summary_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dmi_median",
        "dmi_stress",
        "income_pressure_spread",
        "income_pressure_tilt",
        "most_pressured_group",
        "least_pressured_group"
      ],
      "properties": {
        "dmi_median": {
          "type": "number"
        },
        "dmi_stress": {
          "type": "number"
        },
        "income_pressure_spread": {
          "type": "number",
          "minimum": 0
        },
        "income_pressure_tilt": {
          "type": "number"
        },
        "most_pressured_group": {
          "type": "string",
          "pattern": "^Q[1-5]$"
        },
        "least_pressured_group": {
          "type": "string",
          "pattern": "^Q[1-5]$"
        }
      }
    },
    "inflation_contributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "category_id", "contribution"],
        "properties": {
          "group_id": {
            "type": "string",
            "pattern": "^Q[1-5]$"
          },
          "category_id": {
            "type": "string"
          },
          "contribution": {
            "type": "number"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["computed_at", "num_groups", "num_categories"],
      "properties": {
        "computed_at": {
          "type": "string",
          "format": "date-time"
        },
        "num_groups": {
          "type": "integer",
          "minimum": 1
        },
        "num_categories": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
