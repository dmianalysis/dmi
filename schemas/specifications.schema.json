{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmianalysis.org/schemas/specifications.schema.json",
  "title": "DMI Specifications Manifest",
  "description": "Public robustness/specifications manifest emitted by scripts/build_specifications_manifest.py. Enumerates the published specifications for a reference period and records the robustness assessment across them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "reference_period",
    "headline_spec",
    "specifications",
    "robustness_assessment"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "reference_period": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "headline_spec": {
      "type": "string",
      "enum": ["baseline"]
    },
    "specifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spec_id", "label", "summary", "release_json", "metrics"],
        "properties": {
          "spec_id": {
            "type": "string",
            "enum": ["baseline", "slack_plus"]
          },
          "label": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "release_json": {
            "type": "string",
            "format": "uri-reference",
            "pattern": "^/data/outputs/dmi_release_\\d{4}-\\d{2}(?:_slack_plus)?\\.json$"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dmi_median",
              "dmi_stress",
              "income_pressure_spread",
              "income_pressure_tilt",
              "most_pressured_group",
              "least_pressured_group",
              "slack",
              "slack_measure"
            ],
            "properties": {
              "dmi_median": {"type": "number"},
              "dmi_stress": {"type": "number"},
              "income_pressure_spread": {"type": "number", "minimum": 0},
              "income_pressure_tilt": {"type": "number"},
              "most_pressured_group": {"type": "string", "pattern": "^Q[1-5]$"},
              "least_pressured_group": {"type": "string", "pattern": "^Q[1-5]$"},
              "slack": {"type": "number", "minimum": 0},
              "slack_measure": {"type": "string", "enum": ["u3", "u6"]}
            }
          }
        }
      }
    },
    "robustness_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pressure_tilt_sign_consistent",
        "stress_group_consistent",
        "notes"
      ],
      "properties": {
        "pressure_tilt_sign_consistent": {"type": "boolean"},
        "stress_group_consistent": {"type": "boolean"},
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
